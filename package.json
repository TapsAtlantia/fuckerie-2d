{
  "name": "fuckerie-2d",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Hybrid 2D sandbox engine (Terraria core + Mindustry/Minecraft/Stardew) — Phase 2: World Generation Deep-Dive + Inventory",
  "scripts": {
    "dev": "node scripts/build-worker.mjs && vite",
    "typecheck": "tsc --noEmit",
    "build:worker": "node scripts/build-worker.mjs",
    "build": "node scripts/build-worker.mjs && tsc --noEmit && vite build",
    "build:artifact": "node scripts/build-worker.mjs && node scripts/make-artifact.mjs artifact/index.html",
    "preview": "vite preview"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "dependencies": {
    "peerjs": "^1.5.5"
  }
}
